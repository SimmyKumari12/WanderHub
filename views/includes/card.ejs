<div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4">
    <div class="card position-relative">

        <i class="fa-heart heart-icon <%= isFav ? 'fa-solid active' : 'fa-regular' %>"
   data-id="<%= listing._id %>"></i>

        <a href="/listings/<%= listing._id %>" class="listing-link">
            
            <div class="card-img-wrapper">
                <img src="<%= listing.image %>" class="card-img-top">

                <div class="card-content">
                    <h5 class="card-title"><%= listing.title %></h5>
                    <p class="card-price">₹ <%= listing.price?.toLocaleString("en-IN") || "N/A" %> / night</p>
                    <p class="card-loc"><%= listing.location %>, <%= listing.country %></p>
                </div>
            </div>

        </a>
    </div>
</div>