<link rel="stylesheet" href="/css/show.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<% layout('/layouts/boilerplate') -%>

<div class="show-page">

    <!-- Title -->
    <div class="show-header">
        <h1 class="show-title"><%= listing.title %></h1>

        <p class="show-location">
            <i class="fa-solid fa-location-dot"></i>
            <%= listing.location %>, <%= listing.country %>
        </p>
    </div>

    <!-- Image Gallery -->
    <div class="gallery">

        <div class="gallery-main">
            <img src="<%= listing.image %>" alt="<%= listing.title %>">
        </div>

        <div class="gallery-side">
            <img src="<%= listing.image %>" alt="">
            <img src="<%= listing.image %>" alt="">
            <img src="<%= listing.image %>" alt="">
            <img src="<%= listing.image %>" alt="">
        </div>

    </div>

    <!-- Content -->
    <div class="show-content">

        <!-- Left -->
        <div class="show-left">

            <div class="info-card">

                <h3>About this place</h3>

                <p class="show-desc">
                    <%= listing.description %>
                </p>

            </div>

            <div class="info-card">

                <h3>Property Highlights</h3>

                <div class="features">

                    <div class="feature">
                        <i class="fa-solid fa-house"></i>
                        Entire Property
                    </div>

                    <div class="feature">
                        <i class="fa-solid fa-user-group"></i>
                        4 Guests
                    </div>

                    <div class="feature">
                        <i class="fa-solid fa-bed"></i>
                        2 Bedrooms
                    </div>

                    <div class="feature">
                        <i class="fa-solid fa-bath"></i>
                        2 Bathrooms
                    </div>

                    <div class="feature">
                        <i class="fa-solid fa-wifi"></i>
                        Free Wi-Fi
                    </div>

                    <div class="feature">
                        <i class="fa-solid fa-car"></i>
                        Free Parking
                    </div>

                </div>

            </div>

        </div>

        <!-- Right -->
        <div class="show-right">
            
            <div class="owner-card">

                <div class="owner-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div class="owner-info">
                    <span class="owner-label">Hosted by</span>
                    <h3><%= listing.owner.username %></h3>
                    <p>Listing owner</p>
                </div>
            </div>

            <div class="price-card">

                <h2 class="price">
                    ₹<%= listing.price?.toLocaleString("en-IN") || "N/A" %>
                </h2>

                <span class="per-night">per night</span>

                <hr>

            <% if (currentUser && listing.owner && listing.owner._id.toString() === currentUser._id.toString()) { %>

                <div class="action-buttons">

                    <a href="/listings/<%= listing._id %>/edit"
                    class="edit-btn">
                        <i class="fa-solid fa-pen"></i>
                        Edit Listing
                    </a>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                        onsubmit="return confirmDelete()">

                        <button class="delete-btn">
                            <i class="fa-solid fa-trash"></i>
                            Delete Listing
                        </button>

                    </form>

                </div>

            <% } %>

            </div>
        </div>
    </div>
    
    <!-- //Map Section -->
    <div class="map-section">

        <div class="map-header">
            <h2>Where you'll be</h2>
            <p>
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <div id="map"></div>

    </div>

    <!-- Review Section -->
    <div class="reviews-section">

        <!-- Reviews Header -->
        <div class="reviews-header">

            <div>
                <h2>Reviews</h2>
                <p>See what guests are saying about this place.</p>
            </div>

            <div class="rating-summary">

                <% if (listing.reviews.length > 0) { %>

                    <span class="rating-number">
                        <%= (
                            listing.reviews.reduce((sum, review) => sum + review.rating, 0)
                            / listing.reviews.length
                        ).toFixed(1) %>
                    </span>

                    <span class="rating-star">★</span>

                    <span class="review-count">
                        <%= listing.reviews.length %>
                        <%= listing.reviews.length === 1 ? "review" : "reviews" %>
                    </span>

                <% } else { %>

                    <span class="rating-number">New</span>

                    <span class="review-count">
                        No reviews yet
                    </span>

                <% } %>

            </div>

        </div>


        <!-- Existing Reviews -->
        <div class="reviews-list">

            <% if (listing.reviews.length === 0) { %>

                <p>No reviews yet. Be the first to review this place!</p>

            <% } %>


            <% listing.reviews.forEach(review => { %>

                <div class="review-card">

                    <div class="review-top">

                        <div class="review-user">

                            <div class="user-avatar">
                                <%= review.author.username.charAt(0).toUpperCase() %>
                            </div>

                            <div>
                                <h4>
                                    <%= review.author.username %>
                                </h4>

                                <span>
                                    <%= review.createdAt.toLocaleDateString("en-IN") %>
                                </span>
                            </div>

                        </div>


                        <div class="review-rating">

                            <% for(let i = 1; i <= 5; i++) { %>

                                <% if(i <= review.rating) { %>
                                    ★
                                <% } else { %>
                                    ☆
                                <% } %>

                            <% } %>

                        </div>


                        <% if (currentUser && review.author._id.equals(currentUser._id)) { %>

                            <div class="review-actions">

                                <a
                                    href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit"
                                    class="edit-review-btn">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <form
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="post"
                                    onsubmit="return confirm('Are you sure you want to delete this review?');">

                                    <button
                                        type="submit"
                                        class="delete-review-btn">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                </form>

                            </div>

                        <% } %>

                    </div>


                    <p class="review-text">
                        <%= review.comment %>
                    </p>

                </div>

            <% }) %>

        </div>


        <!-- Add Review -->
        <% if (currentUser) { %>

            <div class="add-review">

                <h3>Leave a review</h3>

                <p class="review-subtitle">
                    Share your experience with other travellers.
                </p>

                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="post"
                    class="needs-validation"
                    novalidate>

                    <div class="rating-input">

                        <label>Your rating</label>

                        <div class="stars">

                            <input type="radio" id="star5" name="rating" value="5" required>
                            <label for="star5">★</label>

                            <input type="radio" id="star4" name="rating" value="4">
                            <label for="star4">★</label>

                            <input type="radio" id="star3" name="rating" value="3">
                            <label for="star3">★</label>

                            <input type="radio" id="star2" name="rating" value="2">
                            <label for="star2">★</label>

                            <input type="radio" id="star1" name="rating" value="1">
                            <label for="star1">★</label>

                        </div>

                    </div>


                    <div class="comment-input">

                        <label for="comment">
                            Your review
                        </label>

                        <textarea
                            id="comment"
                            name="comment"
                            rows="5"
                            class="form-control"
                            placeholder="Share your experience..."
                            minlength="5"
                            maxlength="500"
                            required></textarea>

                        <div class="invalid-feedback">
                            You can't submit an empty review.
                        </div>

                    </div>


                    <button type="submit" class="submit-review-btn">
                        Submit Review
                    </button>

                </form>

            </div>

        <% } else { %>

            <div class="add-review">

                <h3>Want to leave a review?</h3>

                <p class="review-subtitle">
                    Please log in to share your experience with other travellers.
                </p>

                <a
                    href="/login"
                    class="submit-review-btn">
                    Login to Review
                </a>

            </div>

        <% } %>

    </div>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const listingData = {
        lat: "<%= listing.geometry?.lat || '' %>",
        lng: "<%= listing.geometry?.lng || '' %>",
        location: "<%= listing.location %>",
        country: "<%= listing.country %>"
    };

    if (listingData.lat && listingData.lng) {

        const lat = Number(listingData.lat);
        const lng = Number(listingData.lng);

        const map = L.map("map").setView([lat, lng], 10);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([lat, lng])
            .addTo(map)
            .bindPopup(`${listingData.location}, ${listingData.country}`)
            .openPopup();
    }
</script>